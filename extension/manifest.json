{
  "manifest_version": 3,
  "name": "Flash Resume - 1-Click ATS Tailor",
  "version": "1.1.0",
  "description": "Tailor your resume for any open job post and download a verified 1-page PDF in seconds.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:13450/*",
    "http://localhost:13450/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flash Resume"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

